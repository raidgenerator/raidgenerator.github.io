use ::java::util::text::Text
use ::java::data::loot::function::Conditions
use ::java::data::loot::DynamicDrops
use ::java::data::loot::LootCondition
use ::java::data::loot::LootFunction
use ::java::data::loot::LootContextParamSets
use ::java::data::number_provider::IntNumberProviderRef
use ::java::data::number_provider::FloatNumberProviderRef

enum(string) RaidTier {
	Tier_One = "TIER_ONE",
	Tier_Two = "TIER_TWO",
	Tier_Three = "TIER_THREE",
	Tier_Four = "TIER_FOUR",
	Tier_Five = "TIER_FIVE",
	Tier_Six = "TIER_SIX",
	Tier_Seven = "TIER_SEVEN",
}

enum(string) RaidType {
	Normal = "NORMAL",
	Fighting = "FIGHTING",
	Flying = "FLYING",
	Poison = "POISON",
	Ground = "GROUND",
	Rock = "ROCK",
	Bug = "BUG",
	Ghost = "GHOST",
	Steel = "STEEL",
	Fire = "FIRE",
	Water = "WATER",
	Grass = "GRASS",
	Electric = "ELECTRIC",
	Psychic = "PSYCHIC",
	Ice = "ICE",
	Dragon = "DRAGON",
	Dark = "DARK",
	Fairy = "FAIRY",
	Stellar = "STELLAR",
}

enum(string) BaseFeatureLegacy {
    Default = "DEFAULT",
    Mega = "MEGA",
    Tera = "TERA",
    Dynamax = "DYNAMAX",
}

enum(string) BaseFeature {
    Default = "default",
    Mega = "mega",
    Tera = "tera",
    Dynamax = "dynamax",
    #[since="0.11.0"] Shadow = "shadow",
}

type RaidFeature = (#[until="0.11.0"] BaseFeatureLegacy | #[since="0.11.0"] BaseFeature | #[since="0.11.0"] string)

enum(string) Gender {
    Male = "MALE",
    Female = "FEMALE",
    Genderless = "GENDERLESS"
}

enum(string) MovesetBuilder {
	Best_Level_Up_Primary = "level_up_primary",
	Best_Level_Up_Secondary = "level_up_secondary",
	Best_Level_Up_Any = "level_up_any",
	Best_TM_Primary = "tm_primary",
	Best_TM_Secondary = "tm_secondary",
	Best_TM_Any = "tm_any",
	Best_Move_Primary = "move_primary",
	Best_Move_Secondary = "move_secondary",
	Best_Move_Any = "move_any",
	Random_Level_Up_Coverage = "level_up_coverage",
	Random_TM_Coverage = "tm_coverage",
	Random_Move_Coverage = "move_coverage",
	Random_Offensive_TM = "offensive_tm",
}

type Move = (MovesetBuilder | string | [(MovesetBuilder | string)])

struct Evs {
    hp?: int @ 0..,
    atk?: int @ 0..,
    def?: int @ 0..,
    spa?: int @ 0..,
    spd?: int @ 0..,
    spe?: int @ 0..,
}

struct CustomProperties {
    name: string,
    value: (string | int | boolean),
}

struct BaseProperties {
    gender?: Gender,
    ability?: string,
    nature?: string,
    level?: int @ 1..,
    moves?: (#[until="0.12.1"] [string] @ 1..4 | #[since="0.12.1"] [Move] @ 1..4),
    min_perfect_ivs?: int @ 0..6,
    evs?: Evs,
    held_item?: string,
    aspects?: [string],
    form?: string,
    /// Assigns all custom forms and aspects of the Pokemon
    custom_properties?: [CustomProperties],
    #[since="0.12.1"] dmax_level?: boolean,
    gmax?: boolean,
    #[since="0.11.4"] tera_type?: RaidType,
}

struct RewardProperties {
	species: string @ 1..,
	...BaseProperties,
}

struct BossProperties {
    species?: string,
	...BaseProperties,
}

struct UniqueKey {
    item: string,
    id: string
}

type Key = (string | UniqueKey)

enum(string) NodeType {
	Raid = "raid",
	Recover = "recover",
	Boss = "boss",
}

struct Node {
	type: NodeType,
	...cobblemonraiddens:node[[type]],
}

dispatch cobblemonraiddens:node[raid] to struct RaidNode {
	bosses: [string],
	can_catch?: boolean
}

enum(string) Terrain {
    Electric_Terrain = "electricterrain",
    Grassy_Terrain = "grassyterrain",
    Misty_Terrain = "mistyterrain",
    Psychic_Terrain = "psychicterrain",
}

enum(string) Weather {
    Rain = "raindance",
    Sandstorm = "sandstorm",
    Snow = "snow",
    Sun = "sunnyday",
    Primordial_Sea = "primordialsea",
    Desolate_Land = "desolateland",
    Delta_Stream = "deltastream"
}

enum(string) ScriptTarget {
    Player = "player",
    Boss = "boss",
}

enum(string) CatchRateOperation {
    Add = "add",
    Multiply = "multiply",
}

struct StatBoosts {
    hp?: int @ -12..12,
    atk?: int @ -12..12,
    def?: int @ -12..12,
    spa?: int @ -12..12,
    spd?: int @ -12..12,
    spe?: int @ -12..12,
}

enum(string) ScriptType {
    Shield = "shield",
    Set_Terrain = "set_terrain",
    Set_Weather = "set_weather",
    Reset_Stats = "reset_stats",
    Modify_Catch_Rate = "modify_catch_rate",
    Heal = "heal",
    Reduce_Timer = "reduce_timer",
    Timer = "timer",
    Use_Move = "use_move",
    Player_Stats = "player_stats",
    Boss_Stats = "boss_stats",
    Forme_Change = "forme_change",
    Mega_Evolve = "mega_evolve",
    Dynamax = "dynamax",
    Terastallize = "terastallize",
    Add_Script = "add_script",
    Scale = "scale",
    Play_Sound = "play_sound",
    With_Chance = "with_chance",
    #[since="0.11.2"] Run_Command = "run_command",
    #[since="0.11.7"] Clear_All_Stats = "clear_all_stats",
}

struct Script {
	type: ScriptType,
	...cobblemonraiddens:script[[type]],
}

struct ScriptMap {
	values: struct { [string]: Script, },
}

dispatch cobblemonraiddens:script[shield] to struct ShieldScript {
	apply?: boolean
}

dispatch cobblemonraiddens:script[set_terrain] to struct TerrainScript {
	terrain: (string | Terrain)
}

dispatch cobblemonraiddens:script[set_weather] to struct WeatherScript {
	weather: (string | Weather)
}

dispatch cobblemonraiddens:script[reset_stats] to struct ResetStatsScript {
    target: ScriptTarget,
}

dispatch cobblemonraiddens:script[modify_catch_rate] to struct ModifyCatchRateScript {
    value: float,
    apply_to_all?: boolean,
    operation: CatchRateOperation,
}

dispatch cobblemonraiddens:script[heal] to struct HealScript {
    value: float @ 0..1,
}

dispatch cobblemonraiddens:script[reduce_timer] to struct ReduceTimerScript {
    value: float @ 0..1,
}

dispatch cobblemonraiddens:script[timer] to struct TimerScript {
    value: int @ 1..,
}

dispatch cobblemonraiddens:script[use_move] to struct UseMoveScript {
    move: string,
    target: int @ 0..1,
}

dispatch cobblemonraiddens:script[player_stats] to struct PlayerStatsScript {
    /// Positive values lower the player's stats.
    stats: StatBoosts,
}

dispatch cobblemonraiddens:script[boss_stats] to struct BossStatsScript {
    stats: StatBoosts,
}

dispatch cobblemonraiddens:script[forme_change] to struct FormeChangeScript {
    form: string,
}

dispatch cobblemonraiddens:script[mega_evolve] to struct MegaEvolveScript {}

dispatch cobblemonraiddens:script[dynamax] to struct DynamaxScript {}

dispatch cobblemonraiddens:script[terastallize] to struct TerastallizeScript {}

dispatch cobblemonraiddens:script[add_script] to struct AddScriptScript {
    trigger: string,
    scripts: [Script],
}

dispatch cobblemonraiddens:script[scale] to struct ScaleScript {
    scale: float @ 0<..,
    rate?: float @ 0<..,
}

dispatch cobblemonraiddens:script[play_sound] to struct PlaySoundScript {
    sound: string,
    is_music?: boolean,
}

dispatch cobblemonraiddens:script[with_chance] to struct WithChanceScript {
    chance: float @ 0..1,
    scripts: [Script],
}

dispatch cobblemonraiddens:script[run_command] to struct RunCommandScript {
    target?: string,
    command: string,
}

dispatch cobblemonraiddens:script[clear_all_stats] to struct ClearAllStatsScript {
    target: ScriptTarget,
}

enum(string) AI {
    Random = "random",
    Strong = "strong",
    RCT = "rct",
}

type RaidAI = (string | AI)

enum(string) RaidBattleFormat {
    Singles = "SINGLES",
    Doubles = "DOUBLES",
    Triples = "TRIPLES",
    Quadruples = "QUADRUPLES",
    Pentuples = "PENTUPLES",
    Sextuples = "SEXTUPLES",
    Raid = "RAID",
}

struct BaseBoss {
    /// Special raid gimmicks.
    raid_feature?: RaidFeature,
    /// Loot table id for additional loot from the raid.
    loot_table?: string,
    weight?: double,
    /// The list of raid den structures and structure pools the boss can spawn in.
    den?: [string],
    /// A unique key required to enter the raid.
    key?: Key,
    boss_bar_text?: Text,
    scale?: float,
    /// Force the raid boss into a permanent Dynamax forme.
    force_dynamax?: boolean,
    music?: string,
    #[since="0.11.0"] no_ai?: boolean,
    #[since="0.14.0"] adventure?: [Node],
    max_players?: int @ -1..,
    max_clears?: int @ -1..,
    /// The hidden ability rate for raid bosses
    ha_rate?: double @ 0..1,
    max_cheers?: int @ -1..,
    /// The maximum number of Pokemon a player can bring to the raid battle
    raid_party_size?: int @ 1..6,
    health_multi?: int @ 1..,
    /// A multiplier for extra HP based on the raid boss's base (post-multiplier) HP for every new player that joins
    multiplayer_health_multi?: float @ 1..,
    shinyRate?: float @ -1..,
    currency?: int @ 0..,
    /// The maximum number of players that can catch the raid boss
    max_catches?: int @ -1..,
    script?: ScriptMap,
    raid_ai?: RaidAI,
    marks?: [string],
    lives?: int @ 1..,
    players_share_lives?: boolean,
    /// How much raid energy the raid will give to a player's raid shard
    energy?: int @ 0..,
    /// The damage threshold a player must meet to receive the rewards
    required_damage?: float @ 0..1,
    catch_rate?: float @ 0..1,
    #[since="0.14.0"] battle_format?: RaidBattleFormat,
}

dispatch minecraft:resource[cobblemonraiddens:raid/boss] to struct RaidBoss {
    /// The base properties of the Raid Boss and Reward Pokemon.
	pokemon: RewardProperties,
	/// The properties which are added to the base properties for the Raid Boss only.
	boss?: BossProperties,
    raid_tier: RaidTier,
    raid_type: RaidType,
    ...BaseBoss,
}

struct AdditionBoss {
    /// The base properties of the Raid Boss and Reward Pokemon.
	pokemon?: BossProperties,
	/// The properties which are added to the base properties for the Raid Boss only.
	boss?: BossProperties,
    raid_tier?: RaidTier,
    raid_type?: RaidType,
    ...BaseBoss,
}

dispatch minecraft:resource[cobblemonraiddens:raid/boss_additions] to struct BossAdditions {
    // Larger numbers are loaded first.
    priority?: int,
    include?: [string],
    exclude?: [string],
    additions: AdditionBoss,
    replace?: boolean,
    suffix?: string,
    force_apply?: boolean,
    #[since="0.11.1"] extend_tags?: boolean,
}

struct Filter {
    tier?: [RaidTier],
    type?: [RaidType],
    feature?: [RaidFeature],
    boss?: [string],
}

dispatch minecraft:resource[cobblemonraiddens:raid/bucket] to struct RaidBucket {
    include?: Filter,
    exclude?: Filter,
    #[since="0.14.0"] adventure?: boolean,
    /// Add `*` to include all biomes
    biome: [string],
    weight?: double,
}

enum(string) RaidFunctionType {
	MaxMushroomsFunction = "cobblemonraiddens:max_mushrooms_function",
	TeraShardsFunction = "cobblemonraiddens:tera_shards_function",
	GemTypeFunction = "cobblemonraiddens:gem_type_function",
	#[since="0.11.0"] ShadowShardsFunction = "cobblemonraiddens:shadow_shards_function",
	#[since="0.11.0"] ScentsFunction = "cobblemonraiddens:scents_function",
	#[since="0.12.1"] TMTypeFunction = "cobblemonraiddens:tm_type_function",
	ApplyBonus = "minecraft:apply_bonus",
	CopyName = "minecraft:copy_name",
	CopyCustomData = "minecraft:copy_custom_data",
	CopyComponents = "minecraft:copy_components",
	CopyState = "minecraft:copy_state",
	EnchantRandomly = "minecraft:enchant_randomly",
	EnchantWithLevels = "minecraft:enchant_with_levels",
	ExplorationMap = "minecraft:exploration_map",
	ExplosionDecay = "minecraft:explosion_decay",
	Filtered = "minecraft:filtered",
	FurnaceSmelt = "minecraft:furnace_smelt",
	FillPlayerHead = "minecraft:fill_player_head",
	LimitCount = "minecraft:limit_count",
	EnchantedCountIncrease = "minecraft:enchanted_count_increase",
	Reference = "minecraft:reference",
	Sequence = "minecraft:sequence",
	SetAttributes = "minecraft:set_attributes",
	SetBannerPattern = "minecraft:set_banner_pattern",
	SetContents = "minecraft:set_contents",
	ModifyContents = "minecraft:modify_contents",
	SetItem = "minecraft:set_item",
	SetCount = "minecraft:set_count",
	SetDamage = "minecraft:set_damage",
	SetEnchantments = "minecraft:set_enchantments",
	SetInstrument = "minecraft:set_instrument",
	SetLootTable = "minecraft:set_loot_table",
	SetLore = "minecraft:set_lore",
	SetName = "minecraft:set_name",
	SetComponents = "minecraft:set_components",
	SetCustomData = "minecraft:set_custom_data",
	SetCustomModelData = "minecraft:set_custom_model_data",
	SetPotion = "minecraft:set_potion",
	SetStewEffect = "minecraft:set_stew_effect",
	SetFireworks = "minecraft:set_fireworks",
	SetFireworkExplosion = "minecraft:set_firework_explosion",
	SetBookCover = "minecraft:set_book_cover",
	SetWritableBookPages = "minecraft:set_writable_book_pages",
	SetWrittenBookPages = "minecraft:set_written_book_pages",
	ToggleTooltips = "minecraft:toggle_tooltips",
	SetOminousBottleAmplifier = "minecraft:set_ominous_bottle_amplifier",
}

struct RaidLootFunction {
	function: #[id] RaidFunctionType,
	...minecraft:loot_function[[function]],
}

enum(string) RaidConditionType {
    RaidPouchCondition = "cobblemonraiddens:raid_pouch_condition",
    BonusLootCondition = "cobblemonraiddens:bonus_loot_condition"
    AnyOf = "minecraft:any_of",
	AllOf = "minecraft:all_of",
	BlockStateProperty = "minecraft:block_state_property",
	DamageSourceProperties = "minecraft:damage_source_properties",
	EnchantmentActiveCheck = "minecraft:enchantment_active_check",
	EntityProperties = "minecraft:entity_properties",
	EntityScores = "minecraft:entity_scores",
	Inverted = "minecraft:inverted",
	KilledByPlayer = "minecraft:killed_by_player",
	LocationCheck = "minecraft:location_check",
	MatchTool = "minecraft:match_tool",
	RandomChance = "minecraft:random_chance",
	RandomChanceWithEnchantedBonus = "minecraft:random_chance_with_enchanted_bonus",
	Reference = "minecraft:reference",
	SurvivesExplosion = "minecraft:survives_explosion",
	TableBonus = "minecraft:table_bonus",
	TimeCheck = "minecraft:time_check",
	ValueCheck = "minecraft:value_check",
	WeatherCheck = "minecraft:weather_check",
}

struct RaidLootCondition {
	condition: #[id] RaidConditionType,
	...minecraft:loot_condition[[condition]],
}

dispatch cobblemonraiddens:loot_condition[cobblemonraiddens:raid_pouch_condition] to struct RaidPouchCondition {
	apply: boolean,
}
dispatch cobblemonraiddens:loot_condition[cobblemonraiddens:bonus_loot_condition] to struct BonusLootCondition {
	tier?: RaidTier,
	type?: RaidType,
	feature?: string,
	isAdventure?: boolean,
}

enum(string) RaidEntryType {
	Empty = "minecraft:empty",
	Dynamic = "minecraft:dynamic",
	Item = "minecraft:item",
	LootTable = "minecraft:loot_table",
	Tag = "minecraft:tag",
	Alternatives = "minecraft:alternatives",
	Group = "minecraft:group",
	Sequence = "minecraft:sequence",
}

struct RaidLootPoolEntry {
	type: #[id] RaidEntryType,
	...cobblemonraiddens:loot_pool_entry[[type]],
}

dispatch cobblemonraiddens:loot_pool_entry[empty] to RaidSingletonEntry

struct RaidEntryBase {
	conditions?: [RaidLootCondition],
}

struct RaidSingletonEntry {
	weight?: int @ 1..,
	quality?: int,
	...RaidEntryBase,
	functions?: [RaidLootFunction],
}

struct RaidCompositeEntry {
	children: [RaidSingletonEntry] @ 1..,
	...RaidEntryBase,
}

dispatch cobblemonraiddens:loot_pool_entry[empty] to RaidSingletonEntry
dispatch cobblemonraiddens:loot_pool_entry[dynamic] to struct RaidDynamicEntry {
	name: #[id] DynamicDrops,
	...RaidSingletonEntry,
}
dispatch cobblemonraiddens:loot_pool_entry[item] to struct RaidItemEntry {
	name: #[id="item"] string,
	...RaidSingletonEntry,
}
dispatch cobblemonraiddens:loot_pool_entry[loot_table] to struct RaidLootTableEntry {
	value: (#[id="loot_table"] string | RaidLootTable),
	...RaidSingletonEntry,
}
dispatch cobblemonraiddens:loot_pool_entry[tag] to struct RaidTagEntry {
	name: #[id(registry="item",tags="implicit")] string,
	expand: boolean,
	...RaidSingletonEntry,
}
dispatch cobblemonraiddens:loot_pool_entry[alternatives] to RaidCompositeEntry
dispatch cobblemonraiddens:loot_pool_entry[group] to RaidCompositeEntry
dispatch cobblemonraiddens:loot_pool_entry[sequence] to RaidCompositeEntry

struct RaidLootPool {
	rolls: IntNumberProviderRef,
	bonus_rolls?: FloatNumberProviderRef,
	entries: [RaidLootPoolEntry],
	functions?: [RaidLootFunction],
	conditions?: [RaidLootCondition],
}

dispatch minecraft:resource[cobblemonraiddens:loot_table/raid/tier] to struct RaidLootTable {
	type?: #[id] LootContextParamSets,
	pools?: [RaidLootPool],
	functions?: [RaidLootFunction],
	random_sequence?: #[id(registry="random_sequence",definition=true)] string,
}
